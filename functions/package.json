{
  "name": "lionsclub-functions",
  "description": "Cloud Functions for Lions Club Düsseldorf-Jan-Wellem",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npx firebase-tools deploy --only functions --project lc-janwellem-web",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "firebase-admin": "^11.8.0",
    "firebase-functions": "^4.3.1",
    "nodemailer": "^6.9.13"
  },
  "private": true
}
